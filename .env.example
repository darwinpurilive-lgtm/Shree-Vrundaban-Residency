# =================================================================
# Shree Vrundaban Residency - Production Environment Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# =================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------
# 1. Production PostgreSQL Database Configuration
# -----------------------------------------------------------------
# Supply your PostgreSQL connection string:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Examples:
#   Local / Self-hosted: postgresql://hoteladmin:hotelsecurepass2026@localhost:5432/shree_vrundaban_db
#   Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
#   Neon: postgresql://user:pass@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://hoteladmin:hotelsecurepass2026@localhost:5432/shree_vrundaban_db

# Alternative individual PostgreSQL parameters (used if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=hoteladmin
# PGPASSWORD=hotelsecurepass2026
# PGDATABASE=shree_vrundaban_db
# PGSSLMODE=disable

# Fallback SQLite path (used only if DATABASE_URL and PGHOST are omitted):
# DATABASE_PATH=data/hotel.sqlite

# -----------------------------------------------------------------
# 2. Supabase Storage (Persistent Cloud Media Bucket)
# -----------------------------------------------------------------
# Supabase Project URL:
SUPABASE_URL=https://xfwkpaviggxhoonsptdg.supabase.co

# Supabase secret service_role key (from Supabase Dashboard -> Project Settings -> API)
# WARNING: Keep this strictly on the backend; NEVER expose to frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Local disk directory (used as fallback if Supabase Storage credentials are unset):
# In development: public/uploads
# On a production VPS: /var/lib/shree-vrundaban/uploads
UPLOAD_DIR=public/uploads

# Directory where database backup dumps are saved:
# On a production VPS: /var/backups/shree-vrundaban
BACKUP_DIR=backups

# -----------------------------------------------------------------
# 3. Initial Administrator Credentials
# -----------------------------------------------------------------
# Used only during initial database bootstrap if no admin accounts exist:
ADMIN_INITIAL_EMAIL=admin@hotel.com
ADMIN_INITIAL_PASSWORD=replace_with_a_secure_production_password

# -----------------------------------------------------------------
# 4. Public Web Application Base URL
# -----------------------------------------------------------------
APP_URL=http://localhost:3000

# -----------------------------------------------------------------
# 5. Optional Integrations
# -----------------------------------------------------------------
# Google Gemini API key (optional):
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
